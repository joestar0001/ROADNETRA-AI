# =============================================================
#  ROADNETRA AI · FRONTEND settings (FINAL PROJECT/frontend/.env)
#  Copy to .env and paste your live map API key. The server reads this
#  file and serves it to every page at /config.js.
# =============================================================

# ---- Live map ----
# auto     : picks from the key format (AIza... = google, pk.... = mapbox, other = maptiler)
#            and uses free Esri dark tiles when MAP_API_KEY is empty
# esri     : Esri dark canvas (no key)
# osm      : OpenStreetMap standard (no key)
# carto    : CARTO dark matter (no key)
# maptiler : https://cloud.maptiler.com/account/keys/
# mapbox   : https://account.mapbox.com/access-tokens/  (public pk.* token)
# google   : Google Maps JavaScript API key (enable "Maps JavaScript API")
MAP_PROVIDER=auto
MAP_API_KEY=
# dark | light | streets | satellite
MAP_STYLE=dark

# Map centre when there are no incidents yet
MAP_DEFAULT_LAT=28.3589
MAP_DEFAULT_LNG=76.9387
MAP_DEFAULT_ZOOM=11

# ---- Live Lab streaming ----
# Width of frames sent to Model B (accident, every frame) and Model A (infrastructure, sampled)
ACCIDENT_STREAM_WIDTH=640
INFRA_STREAM_WIDTH=1280
# How often Model A samples a frame (1000 ms = 1 FPS, per the architecture)
INFRA_INTERVAL_MS=1000
# How often dashboards refresh incidents from the backend
INCIDENT_POLL_MS=3000
