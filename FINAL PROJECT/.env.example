# =============================================================
#  ROADNETRA AI · BACKEND settings (FINAL PROJECT/.env)
#  Copy to .env and edit. Paths are relative to FINAL PROJECT/.
# =============================================================

# ---- Server ----
PORT=8080
HOST=0.0.0.0

# ---- The 3 models ----
# Model A: road infrastructure (pothole, damaged_sign, damaged_divider, faded_zebra_crossing)
POTHOLE_MODEL_PATH=models/pothole_best.pt
# Model B: severe accident (shared with the training pipeline in the repo-root models/ folder)
ACCIDENT_MODEL_PATH=../models/accident_best.pt
# Stage-2 Judge: COCO YOLOv8n used to veto vehicles/people mistaken for defects
JUDGE_MODEL_PATH=models/yolov8n.pt

# auto | cpu | cuda | cuda:0 | mps
DEVICE=auto
# CPU threads for inference (Model A and Model B run concurrently). Default = a third of your cores.
TORCH_THREADS=

# Inference resolution
POTHOLE_IMGSZ=960
ACCIDENT_IMGSZ=640

# ---- Model A thresholds ----
POTHOLE_CONF=0.28
DAMAGED_SIGN_CONF=0.25
DAMAGED_DIVIDER_CONF=0.20
FADED_ZEBRA_CONF=0.20
# A defect must be seen in this many sampled frames before an incident is raised (video only)
INFRA_CONFIRM_FRAMES=2

# ---- Model B thresholds (tuned on the 273-image held-out test set) ----
# Accept when confidence >= ACCIDENT_CONF, or >= ACCIDENT_MIN_CONF if the judge sees a vehicle.
ACCIDENT_CONF=0.55
ACCIDENT_MIN_CONF=0.40
# Multi-frame verification for video streams
ACCIDENT_CONFIRM_FRAMES=3
# ...within this many consecutive processed frames (isolated hits never add up)
ACCIDENT_CONFIRM_WINDOW=5

# ---- Duplicate merging (minutes) ----
MERGE_WINDOW_INFRA_MIN=720
MERGE_WINDOW_ACCIDENT_MIN=15

# ---- Location ----
# Camera used when the operator does not pick one (see data/cameras.json)
DEFAULT_CAMERA_ID=CAM-084
# Seed 5 sample incidents when the incident store is empty
SEED_DEMO_INCIDENTS=true

# ---- Roboflow (training only) ----
# Used by training/model_b_accident_colab.ipynb to download the Roboflow Universe datasets.
# Get it at roboflow.com -> Settings -> API Keys. Not needed to run the server.
ROBOFLOW_API_KEY=
